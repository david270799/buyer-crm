rules_version = '2';

// All reads and writes go through the backend (Telegram bot, Mini App API,
// dashboard API), which uses the Firebase Admin SDK and bypasses these rules.
// Browsers and Mini Apps never talk to Firestore directly, so nothing is
// allowed here. In particular balance, transactions and audit_logs can only
// be changed by backend code.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

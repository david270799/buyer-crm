# Скопируйте в .env (в корне репозитория) и заполните. Файл .env в git не попадает.

# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администратора (несколько — через запятую). При первом запуске можно оставить
# пустым: напишите боту /start — он покажет ваш ID; впишите его сюда и перезапустите.
ADMIN_TELEGRAM_IDS=
# Необязательно: ID групп, где бот работает (через запятую, обычно начинаются с -100).
# Пусто — бот отвечает в любой группе (админ-команды всё равно только от админа).
ALLOWED_CHAT_IDS=

# --- Mini App ---------------------------------------------------------------
# Публичный HTTPS-адрес, по которому открывается CRM, например https://crm.example.com/
# Бот сам поставит кнопку «CRM». Пусто — бот работает, но Mini App из Telegram не открыть.
MINI_APP_URL=
# Только для docker-compose: домен, на который Caddy получит HTTPS-сертификат (crm.example.com)
DOMAIN=
# Если фронтенд размещён отдельно (например, Firebase Hosting) — его адрес(а) через запятую
WEB_ORIGINS=
# Сколько часов действует вход в Mini App без перезапуска
INIT_DATA_MAX_AGE_HOURS=24
PORT=8080
# 0 — запустить только API без бота (например, если бот работает в другом процессе)
RUN_BOT=1

# --- Данные -------------------------------------------------------------------
# sqlite (по умолчанию) — всё хранится на этом сервере: база, фото, копии;
# firestore — Firebase (тогда нужны строки FIREBASE_* ниже).
STORAGE=sqlite
# Папка с базой (crm.sqlite3), фото (media/) и копиями (backups/).
# По умолчанию — папка data/ в проекте; в Docker — всегда /data (том crm_data).
# DATA_DIR=
# Каждую ночь в 4:00 (Сеул) бот делает копию базы и присылает её админам в Telegram.
# 0 — не присылать (тогда храните копии из data/backups вне сервера сами).
BACKUP_TO_TELEGRAM=1
# Сколько последних копий хранить на сервере
BACKUP_KEEP=14

# --- Firebase (только при STORAGE=firestore) -----------------------------------
# Путь к JSON сервисного аккаунта или то же содержимое одной строкой
FIREBASE_CREDENTIALS=
# FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# --- Gemini (распознавание товара на фото) ------------------------------------
# Ключ из Google AI Studio: https://aistudio.google.com/apikey
# Пусто — заказы по фото всё равно принимаются, бренд и модель заполняете вы.
GEMINI_API_KEY=
# Необязательно: модель (по умолчанию gemini-2.5-flash)
GEMINI_MODEL=

LOG_LEVEL=INFO

# Только для демо-режима (--demo): Telegram ID аккаунта, который будет «клиентом»
DEMO_CLIENT_TELEGRAM_ID=

# Скопируйте в .env (в корне репозитория) и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администратора (несколько — через запятую).
# Узнать свой ID: написать боту /whoami
ADMIN_TELEGRAM_IDS=

# Необязательно: ID групп, в которых бот работает (через запятую, обычно начинается с -100).
# Пусто — бот отвечает в любой группе (админ-команды всё равно только от админа).
ALLOWED_CHAT_IDS=

# Firebase: путь к JSON сервисного аккаунта
# (Firebase Console → Project settings → Service accounts → Generate new private key).
# Храните файл вне репозитория.
FIREBASE_CREDENTIALS=/path/to/service-account.json
# ...или то же содержимое JSON одной строкой (для хостингов без файлов):
# FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
# Понадобится на этапе фото (Phase 3), пример: my-project.appspot.com
FIREBASE_STORAGE_BUCKET=

# Понадобится на этапе AI (Phase 3/9)
GEMINI_API_KEY=

LOG_LEVEL=INFO

# Только для `python -m crm.bot --demo`: Telegram ID аккаунта, который будет «клиентом»
DEMO_CLIENT_TELEGRAM_ID=

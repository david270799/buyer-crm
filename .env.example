# Скопируйте в .env (в корне репозитория) и заполните. Файл .env в git не попадает.

# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администратора (несколько — через запятую). Узнать свой ID: /whoami у бота
ADMIN_TELEGRAM_IDS=
# Необязательно: ID групп, где бот работает (через запятую, обычно начинаются с -100).
# Пусто — бот отвечает в любой группе (админ-команды всё равно только от админа).
ALLOWED_CHAT_IDS=

# --- Mini App ---------------------------------------------------------------
# Публичный HTTPS-адрес, по которому открывается CRM. Бот сам поставит кнопку «CRM».
MINI_APP_URL=https://crm.example.com/
# Для docker-compose (Caddy получит HTTPS-сертификат на этот домен)
DOMAIN=crm.example.com
# Если фронтенд размещён отдельно (например, Firebase Hosting) — его адрес(а) через запятую
WEB_ORIGINS=
# Сколько часов действует вход в Mini App без перезапуска
INIT_DATA_MAX_AGE_HOURS=24
PORT=8080
# 0 — запустить только API без бота (например, если бот работает в другом процессе)
RUN_BOT=1

# --- Firebase ---------------------------------------------------------------
# Путь к JSON сервисного аккаунта
# (Firebase Console → Project settings → Service accounts → Generate new private key).
# Храните файл вне репозитория. В docker-compose: положите его в secrets/service-account.json
FIREBASE_CREDENTIALS=/path/to/service-account.json
# ...или то же содержимое JSON одной строкой (для хостингов без файлов):
# FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
# Хранилище фото, например my-project.firebasestorage.app или my-project.appspot.com
FIREBASE_STORAGE_BUCKET=

# --- Gemini (распознавание товара на фото) ------------------------------------
# Ключ из Google AI Studio: https://aistudio.google.com/apikey
# Пусто — заказы по фото всё равно принимаются, бренд и модель заполняете вы.
GEMINI_API_KEY=
# Необязательно: модель (по умолчанию gemini-2.5-flash)
GEMINI_MODEL=

LOG_LEVEL=INFO

# Только для демо-режима (--demo): Telegram ID аккаунта, который будет «клиентом»
DEMO_CLIENT_TELEGRAM_ID=
